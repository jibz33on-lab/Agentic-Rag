__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Local vector stores / indexes / model caches
.chroma/
chroma/
*.faiss
*.sqlite3
.lancedb/
storage/
.cache/

# The corpus: third-party documents, not ours to redistribute. What describes
# them is committed; they are not. See data/README.md.
# `data/*` rather than `data/`, because an ignored directory cannot have its
# children un-ignored. The old rule here was `data/raw/`, which matched nothing
# — the documents sit directly in data/ — so they were neither tracked nor
# ignored, and only showed up as permanent noise in `git status`.
data/*
!data/README.md
!data/corpus.sha256

# Editors
.idea/
*.swp

# macOS
.DS_Store

# Terraform. State can contain resource metadata and, for some resource types,
# secrets -- it never belongs in a public repo. .terraform/ is a download cache.
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider checksums
# and is the thing that makes an apply reproducible.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
