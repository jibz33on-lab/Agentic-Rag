# Copy to .env and fill in. .env is git-ignored.

# OpenRouter serves the answerer and the embedding model — the thing under test.
OPENROUTER_API_KEY=

# OpenAI serves the evaluation apparatus: the generator that writes
# golden_examples and the judge that scores answers. Deliberately a different
# provider from the answerer, so one provider having a bad day cannot move both
# the experiment and the ruler at once. Only the evaluation commands need it.
OPENAI_API_KEY=

# Local services from docker-compose.yml. Defaults match the compose file.
QDRANT_URL=http://localhost:6333
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin, for browsing the Postgres tables at http://localhost:5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# Models. Both served by OpenRouter.
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ANSWERER_MODEL=deepseek/deepseek-v4-flash-0731

# Where your PDFs and docx files live, relative to the repo root.
DATA_FOLDER=data
# How many chunks to give the model for each question.
TOP_K=4

# The evaluation apparatus. Pinned: a judge that changes with the answerer is
# not a judge, and a run scored by a different judge is not a comparison.
# Dated snapshots, not floating aliases — an alias can be repointed under you.
GENERATOR_MODEL=gpt-4.1-2025-04-14
JUDGE_MODEL=gpt-4o-2024-11-20

# LangSmith, for tracing runs. Traces appear at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=01-basic-rag
# The benchmark every experiment is measured against. It lives in LangSmith,
# not in this repo — evaluate() creates its own experiment project.
# 01-basic-rag-golden is its superseded predecessor: every question there was
# written from a single chunk, so every metric sat at 1.000 with no headroom.
LANGSMITH_DATASET=01-basic-rag-benchmark

# Add per-project keys below as projects need them, e.g.:
# TAVILY_API_KEY=
